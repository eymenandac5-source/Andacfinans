# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret used to sign session tokens and verification cookies.
SESSION_SECRET="change-this-to-a-strong-random-secret-in-production"

# DB_PATH: File path for the SQLite database.
DB_PATH="./data/andac_finans.db"

# Optional SMTP configuration for transactional emails (verification & password reset).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@andacfinans.com"
